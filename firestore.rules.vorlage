rules_version = '2';
// Poolposition – Zugriffsregeln der Datenbank
service cloud.firestore {
  match /databases/{database}/documents {

    // Angemeldet. In der Support-Ansicht („Als Mitglied ansehen“, Kennzeichen supportVon) ist nur Lesen erlaubt.
    function signedIn() { return request.auth != null && (request.method in ['get', 'list'] || request.auth.token.get('supportVon', null) == null); }
    function me() { return request.auth.uid; }
    // Superadmin: wird bei der Einrichtung automatisch eingetragen (E-Mail-Adresse)
    function isSuper() { return signedIn() && request.auth.token.email != null && request.auth.token.email.lower() in __ADMIN_EMAILS__; }
    // Bademeister: Rechte vergibt der Oberbademeister (Superadmin) einzeln, gespeichert unter rollen/{uid}.rechte
    function rollenDoc(u) { return /databases/$(database)/documents/rollen/$(u); }
    function recht(r) { return signedIn() && exists(rollenDoc(me())) && get(rollenDoc(me())).data.get('rechte', {}).get(r, false) == true; }
    function isAdmin() { return isSuper() || recht('reisen'); }
    function isMod() { return isSuper() || recht('meldungen') || recht('verwarnen') || recht('nutzer'); }
    function mDoc(rid, uid) { return /databases/$(database)/documents/mitglied/$(rid + '_' + uid); }
    function isMember(rid) { return signedIn() && exists(mDoc(rid, me())) && get(mDoc(rid, me())).data.status in ['teilnehmer', 'zugesagt', 'abgesagt', 'eingeladen']; }
    function trip(rid) { return get(/databases/$(database)/documents/reisen/$(rid)).data; }
    function isTripAdmin(rid) { return signedIn() && trip(rid).admin == me(); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // Gast einer einzelnen Tagesaktivität (per QR-Code eingeladen)
    function isGast(aid) { return signedIn() && exists(/databases/$(database)/documents/aktgast/$(aid + '_' + me())); }
    function akt(aid) { return get(/databases/$(database)/documents/aktivitaeten/$(aid)).data; }
    function einl(c) { return /databases/$(database)/documents/einladungen/$(c); }
    // Beitritt nur mit gültiger Einladung, die im selben Schritt um 1 verbraucht wird
    function einlOk(c, rid) {
      let e = get(einl(c)).data;
      let n = getAfter(einl(c)).data;
      return e.rid == rid && e.widerrufen == false && e.bis > request.time.toMillis() && e.used < e.max
        && n.used == e.used + 1 && n.nutzer.get(me(), false) == true;
    }

    // Profile: alle Angemeldeten lesen (Namen im Chat), jeder schreibt nur sein eigenes
    match /profile/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
      // Bademeister mit dem Recht „Inhalte ausblenden“ dürfen ein gemeldetes Profilbild entfernen
      allow update: if recht('ausblenden') && onlyChanges(['foto', 'fotoOrig', 'fotoEntfernt']);
    }

    // Reisen: lesbar für Angemeldete
    match /reisen/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == me() && request.resource.data.admin == me();
      // Admin der Reise und System-Admin dürfen alles (auch die Admin-Rolle übertragen).
      // Normale Mitglieder dürfen nur Vortreffen-Hinweis, neue Getränke und den Stand der Auszeichnungen eintragen – nie Admin, Sperren oder Reisedaten.
      allow update: if isTripAdmin(rid) || isAdmin()
        || (recht('ausschliessen') && onlyChanges(['gesperrt']))
        || (isMember(rid) && onlyChanges(['naechstesVortreffen', 'getraenkeKat', 'auszeichnungen']))
        // Infos der Unterkunft: alle Mitglieder, wenn der Gruppenadmin es erlaubt hat
        || (isMember(rid) && resource.data.get('infosOffen', false) == true && onlyChanges(['infos', 'infosVon', 'infosAm']));
      allow delete: if isAdmin();
    }

    // Mitgliedschaften
    match /mitglied/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        (request.resource.data.uid == me() && id == request.resource.data.rid + '_' + me()
          && trip(request.resource.data.rid).get('gesperrt', {}).get(me(), false) != true
          && (trip(request.resource.data.rid).admin == me()
              || (request.resource.data.einladung is string && exists(einl(request.resource.data.einladung))
                  && einlOk(request.resource.data.einladung, request.resource.data.rid))))
        || (request.resource.data.status == 'eingeladen' && isMember(request.resource.data.rid))
        || isAdmin());
      allow update: if signedIn() && (
        (resource.data.uid == me() && resource.data.status != 'entfernt' && request.resource.data.status != 'entfernt')
        || isTripAdmin(resource.data.rid)
        || (isMember(resource.data.rid) && onlyChanges(['platzDabei', 'abholer']))
        || (recht('ausschliessen') && onlyChanges(['status', 'entferntAm']))
        || (recht('reisedaten') && onlyChanges(['anreise', 'abreise']))
        || isAdmin());
      allow delete: if isAdmin();
    }

    // Einladungen (Einmalcodes): einzeln abrufbar per Code, Liste nur für den Admin der Reise
    match /einladungen/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.by == me() || isTripAdmin(resource.data.rid) || isAdmin());
      allow create: if signedIn() && request.resource.data.by == me() && request.resource.data.used == 0
        && (isTripAdmin(request.resource.data.rid) || isAdmin());
      allow update: if signedIn() && (
        ((isTripAdmin(resource.data.rid) || isAdmin()) && onlyChanges(['widerrufen']))
        || (onlyChanges(['used', 'nutzer'])
            && request.resource.data.used == resource.data.used + 1
            && resource.data.used < resource.data.max
            && resource.data.widerrufen == false
            && resource.data.bis > request.time.toMillis()
            && resource.data.nutzer.get(me(), false) != true
            && request.resource.data.nutzer.get(me(), false) == true
            && existsAfter(mDoc(resource.data.rid, me()))
            && getAfter(mDoc(resource.data.rid, me())).data.get('einladung', '') == code));
      allow delete: if isTripAdmin(resource.data.rid) || isAdmin();
    }

    // Inhalte einer Reise: nur für ihre Mitglieder
    match /vorschlaege/{id} {
      allow read: if isMember(resource.data.rid) || isAdmin();
      allow create: if isMember(request.resource.data.rid) && request.resource.data.by == me();
      allow delete: if resource.data.by == me() || isTripAdmin(resource.data.rid) || isAdmin();
    }
    match /stimmen/{id} {
      allow read: if isMember(resource.data.rid) || isAdmin();
      allow create, update: if isMember(request.resource.data.rid) && request.resource.data.uid == me() && id == request.resource.data.rid + '_' + me();
    }
    match /aktivitaeten/{id} {
      allow read: if isMember(resource.data.rid) || isAdmin() || isGast(id);
      allow create: if isMember(request.resource.data.rid) && request.resource.data.by == me();
      allow update: if isMember(resource.data.rid) || isAdmin() || (recht('ausblenden') && onlyChanges(['ausgeblendet']));
      allow delete: if resource.data.by == me() || isAdmin();
    }
    match /nachrichten/{id} {
      // Gäste lesen nur freigegebene Nachrichten ihrer Aktivität
      allow read: if isMember(resource.data.rid) || isAdmin()
        || (resource.data.get('gastSichtbar', false) == true && isGast(resource.data.aktId));
      allow create: if (isMember(request.resource.data.rid) && request.resource.data.by == me()) || isAdmin()
        || (recht('ausschliessen') && request.resource.data.typ == 'system' && request.resource.data.by == 'support')
        || (request.resource.data.by == me() && request.resource.data.gastSichtbar == true
            && request.resource.data.aktId is string && isGast(request.resource.data.aktId)
            && akt(request.resource.data.aktId).rid == request.resource.data.rid
            && request.resource.data.typ in ['text', 'bild', 'audio']
            && request.time.toMillis() <= akt(request.resource.data.aktId).gastBis + (request.resource.data.typ == 'bild' ? 172800000 : 0));
      allow update: if isMember(resource.data.rid) || isAdmin() || (recht('ausblenden') && onlyChanges(['ausgeblendet']))
        || (resource.data.get('gastSichtbar', false) == true && isGast(resource.data.aktId)
            && (onlyChanges(['reakt', 'likes'])
                || (resource.data.by == me() && onlyChanges(['text', 'bearbeitet', 'geloescht']))));
      allow delete: if resource.data.by == me() || isAdmin();
    }

    // Einladungscodes für Tagesaktivitäten
    match /aktcodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == me() && isMember(request.resource.data.rid);
      allow update: if signedIn() && (resource.data.by == me() || isTripAdmin(resource.data.rid) || isAdmin()) && onlyChanges(['widerrufen', 'bis']);
    }
    // Mitteilung an ausgeladene Gäste: nur die betroffene Person liest und löscht sie
    match /ausladungen/{id} {
      allow read, delete: if signedIn() && resource.data.uid == me();
      allow create: if signedIn() && request.resource.data.by == me()
        && (akt(request.resource.data.aktId).by == me() || isTripAdmin(akt(request.resource.data.aktId).rid) || isAdmin());
    }
    // Gäste einer Tagesaktivität: beitreten nur mit gültigem Code, entfernen durch Ersteller oder Admin
    match /aktgast/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && id == request.resource.data.aktId + '_' + me()
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/aktcodes/$(request.resource.data.code)).data.aktId == request.resource.data.aktId
        && get(/databases/$(database)/documents/aktcodes/$(request.resource.data.code)).data.widerrufen == false
        && get(/databases/$(database)/documents/aktcodes/$(request.resource.data.code)).data.bis > request.time.toMillis()
        && akt(request.resource.data.aktId).get('gastGesperrt', {}).get(me(), '') != request.resource.data.code;
      allow delete: if signedIn() && (resource.data.uid == me() || akt(resource.data.aktId).by == me() || isTripAdmin(resource.data.rid) || isAdmin());
    }

    // Kassenbuch: nur Mitglieder der Reise; ändern und löschen darf, wer den Eintrag gemacht hat, oder der Admin
    match /kasse/{id} {
      // Gäste eines Events sehen und ergänzen nur die Einträge dieses Events (auch nach dessen Ende)
      allow read: if isMember(resource.data.rid) || isAdmin()
        || (resource.data.get('aktId', '') != '' && isGast(resource.data.aktId));
      // Eine Rückzahlung („ausgleich“) trägt nur ein, wer das Geld bekommen hat
      allow create: if request.resource.data.by == me()
        && request.resource.data.betrag is int && request.resource.data.betrag > 0
        && (request.resource.data.typ != 'ausgleich' || request.resource.data.an == me())
        && (isMember(request.resource.data.rid)
            || (request.resource.data.aktId is string && isGast(request.resource.data.aktId)
                && akt(request.resource.data.aktId).rid == request.resource.data.rid));
      allow update: if (resource.data.by == me() || isTripAdmin(resource.data.rid)) && request.resource.data.rid == resource.data.rid
        && request.resource.data.get('aktId', '') == resource.data.get('aktId', '');
      allow delete: if resource.data.by == me() || isTripAdmin(resource.data.rid) || isAdmin();
    }

    // Flüstern: Inhalte nur für die beiden Beteiligten (und den Support)
    match /fluester/{pid} {
      allow read: if signedIn();
      allow write: if signedIn() && (me() in pid.split('__') || isAdmin() || (isMod() && 'support' in pid.split('__')));
    }
    match /fluesternachrichten/{id} {
      allow read: if signedIn() && (me() in resource.data.pair.split('__') || isAdmin() || (isMod() && 'support' in resource.data.pair.split('__')));
      allow create: if signedIn() && (
        (me() in request.resource.data.pair.split('__') && request.resource.data.by == me())
        || (isMod() && request.resource.data.by == 'support' && 'support' in request.resource.data.pair.split('__'))
        // Eingangsbestätigung einer eigenen Meldung: nur im eigenen Chat mit der Badeaufsicht, nur Status „offen“
        || (request.resource.data.by == 'support' && request.resource.data.typ == 'meldstatus' && request.resource.data.status == 'offen'
            && me() in request.resource.data.pair.split('__') && 'support' in request.resource.data.pair.split('__')
            && request.resource.data.keys().hasOnly(['pair', 'by', 'typ', 'meld', 'vorgang', 'art', 'kategorie', 'status', 'createdAt'])
            && exists(/databases/$(database)/documents/meldungen/$(me())/eintraege/$(request.resource.data.meld))));
      allow update: if signedIn() && (me() in resource.data.pair.split('__') || isAdmin() || (isMod() && 'support' in resource.data.pair.split('__')) || (recht('ausblenden') && onlyChanges(['ausgeblendet'])));
    }
    match /fluestercodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn();
    }

    // „schreibt gerade …“: je Chat ein Dokument mit Zeitstempeln, jeder schreibt nur seinen eigenen Eintrag
    match /tippen/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly([me()]);
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([me()]);
    }

    // Private Daten (Einstellungen, Urlaubsherzen): nur die Person selbst
    match /data/users/{uid}/{doc=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Meldungen: schreiben nur für sich selbst, bearbeiten Bademeister mit dem Recht „meldungen“
    // Die meldende Person darf der Badeaufsicht nur schreiben, solange der Fall in Bearbeitung (offen) ist, und nur wenn
    // a) im Ticket „Mitglied darf schreiben“ angehakt ist, oder b) eine einmalige Antwort erlaubt ist – die wird dabei verbraucht.
    // Lesen kann sie ihre Meldung nicht (interne Notizen bleiben intern).
    match /meldungen/{uid}/eintraege/{id} {
      allow create: if signedIn() && me() == uid;
      allow read, update: if isSuper() || recht('meldungen');
      allow update: if signedIn() && me() == uid && onlyChanges(['antworten', 'neuAntwort', 'antwortErlaubt'])
        && resource.data.status == 'offen'
        && (resource.data.get('schreibenErlaubt', false) == true
            || (resource.data.get('antwortErlaubt', false) == true && request.resource.data.antwortErlaubt == false));
      allow delete: if isSuper() || recht('loeschen');
    }
    // Konto-Aktivität (erster und letzter Besuch in der App): schreibt jeder nur für sich, lesen nur Oberbademeister und Recht „Nutzer“
    match /konten/{uid} {
      allow read: if signedIn() && (me() == uid || isSuper() || recht('nutzer'));
      allow create, update: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['erstesLogin', 'zuletztAktiv', 'version'])
        && request.auth.token.get('supportVon', null) == null;
    }
    // Protokoll der Support-Ansicht: schreibt nur der Server, lesen nur der Oberbademeister
    match /supportlog/{id} {
      allow read: if isSuper() || recht('support');
    }
    // „Wer bringt was mit?“: Mitglieder der Reise tragen ein und übernehmen; löschen darf, wer es eingetragen hat, oder der Reise-Admin
    // Urlaubsherzen an Gruppenmitglieder: sehen dürfen nur die beiden Beteiligten
    match /herzanfragen/{id} {
      allow read: if signedIn() && (resource.data.von == me() || resource.data.an == me());
      allow create: if request.resource.data.von == me() && request.resource.data.an != me()
        && isMember(request.resource.data.rid)
        && exists(mDoc(request.resource.data.rid, request.resource.data.an))
        && get(mDoc(request.resource.data.rid, request.resource.data.an)).data.status == 'zugesagt'
        && request.resource.data.status == 'offen' && request.resource.data.knisterGepostet == false
        && request.resource.data.keys().hasOnly(['rid', 'von', 'an', 'status', 'vonZeigen', 'anZeigen', 'knisterGepostet', 'offengelegt', 'createdAt']);
      // Empfänger erwidert (oder ändert seine Freigabe), Absender ändert nur seine Freigabe; offengelegt setzt, wer das Geheimnis lüftet
      allow update: if signedIn() && (
          (resource.data.an == me() && onlyChanges(['status', 'anZeigen', 'bestaetigtAm', 'bestaetigtTag', 'knisterAm', 'offengelegt']) && request.resource.data.status in ['offen', 'bestaetigt'])
          || (resource.data.von == me() && onlyChanges(['vonZeigen', 'offengelegt'])));
      allow delete: if signedIn() && (resource.data.von == me() || resource.data.an == me());
    }
    match /mitbringen/{id} {
      allow read: if isMember(resource.data.rid) || isAdmin();
      allow create: if isMember(request.resource.data.rid) && request.resource.data.by == me()
        && request.resource.data.keys().hasOnly(['rid', 'text', 'by', 'wer', 'createdAt']) && request.resource.data.text is string && request.resource.data.text.size() <= 60;
      allow update: if isMember(resource.data.rid) && onlyChanges(['wer', 'am'])
        && (request.resource.data.wer == me() && resource.data.wer == null || resource.data.wer == me() && request.resource.data.wer == null);
      allow delete: if resource.data.by == me() || isTripAdmin(resource.data.rid) || isAdmin();
    }
    // Push-Benachrichtigungen: Geräte-Schlüssel und Einstellungen, nur für einen selbst
    match /pushtokens/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }
    // Ranking der Badeaufsicht: sehen nur Bademeister, jeder zählt nur seine eigenen abgeschlossenen Fälle
    match /bmstat/{uid} {
      allow read: if isSuper() || (signedIn() && exists(rollenDoc(me())));
      allow write: if signedIn() && me() == uid && (isSuper() || recht('meldungen'));
    }
    // Beta-Feedback: Oberbademeister und wer das Recht „feedback“ hat
    match /feedback/{uid}/eintraege/{id} {
      allow create: if signedIn() && (me() == uid || isSuper());
      allow read, update: if isSuper() || recht('feedback');
      allow delete: if isSuper();
    }
    // Infoboard der Badeaufsicht: schreibt nur der Oberbademeister, Bademeister bestätigen nur ihr eigenes „Zur Kenntnis genommen“
    match /infoboard/{id} {
      allow read: if isSuper() || (signedIn() && exists(rollenDoc(me())));
      allow create, delete: if isSuper();
      allow update: if isSuper() || (signedIn() && exists(rollenDoc(me())) && onlyChanges(['gelesen'])
        && request.resource.data.gelesen.diff(resource.data.get('gelesen', {})).affectedKeys().hasOnly([me()]));
    }
    // Bademeister-Rechte und Dienstränge: vergibt nur der Oberbademeister
    match /rollen/{uid} {
      allow read: if signedIn() && (me() == uid || isMod());
      allow write: if isSuper();
    }

    // Sperren: nur der System-Admin
    match /sperren/{uid} {
      allow read: if signedIn();
      allow write: if isSuper() || recht('sperren');
    }
  }
}
