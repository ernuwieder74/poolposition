rules_version = '2';
// Poolposition – Zugriffsregeln für Fotos, Videos und Sprachnachrichten (Beta 3.1)
// Altbestand (uploads/{uid}/{datei}): wie bisher für alle Angemeldeten lesbar.
// Originale (uploads/{uid}/o/…): lesen und hochladen nur mit bezahltem Ticket (Kennzeichen tkb = Ende des Tickets) oder im Team (st). Die Support-Ansicht darf lesen.
// Vorschaubilder (uploads/{uid}/v/…, klein): für alle Angemeldeten lesbar, hochladen nur mit bezahltem Ticket.
service firebase.storage {
  match /b/{bucket}/o {
    function angemeldet() { return request.auth != null; }
    function bezahlt() { return angemeldet() && request.auth.token.get('tkb', 0) > request.time.toMillis(); }
    function team() { return angemeldet() && request.auth.token.get('st', false) == true; }
    function erlaubt() { return request.resource.contentType.matches('image/(jpeg|png|gif|webp)|application/pdf|video/(mp4|webm|quicktime)|audio/(mp4|webm|ogg|mpeg|aac)'); }
    match /uploads/{uid}/{file} {
      allow read: if angemeldet();
      allow create: if angemeldet() && request.auth.uid == uid && !('supportVon' in request.auth.token)
        && request.resource.size < 20 * 1024 * 1024 && erlaubt();
      allow delete: if angemeldet() && !('supportVon' in request.auth.token);
    }
    match /uploads/{uid}/o/{file} {
      allow read: if bezahlt() || team() || (angemeldet() && 'supportVon' in request.auth.token);
      allow create: if bezahlt() && request.auth.uid == uid && !('supportVon' in request.auth.token)
        && request.resource.size < 20 * 1024 * 1024 && erlaubt();
      allow delete: if angemeldet() && !('supportVon' in request.auth.token);
    }
    match /uploads/{uid}/v/{file} {
      allow read: if angemeldet();
      allow create: if bezahlt() && request.auth.uid == uid && !('supportVon' in request.auth.token)
        && request.resource.size < 1024 * 1024 && request.resource.contentType.matches('image/jpeg');
      allow delete: if angemeldet() && !('supportVon' in request.auth.token);
    }
  }
}
