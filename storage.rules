rules_version = '2';
// Poolposition – Zugriffsregeln für Fotos, Videos und Sprachnachrichten
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && !('supportVon' in request.auth.token)
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp)|video/(mp4|webm|quicktime)|audio/(mp4|webm|ogg|mpeg|aac)');
      allow delete: if request.auth != null && !('supportVon' in request.auth.token);
    }
  }
}
